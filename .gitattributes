# Normalize line endings for a Linux-targeted repository.
* text=auto eol=lf
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.py text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.jpg binary
*.png binary
